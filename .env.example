# ========================================
# DATABASE - MongoDB
# ========================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=libraryhub
MONGODB_USER=libraryhub_user
MONGODB_PASSWORD=your_mongo_password
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=your_mongo_root_password

# Admin UI Credentials
MONGODB_EXPRESS_USER=admin
MONGODB_EXPRESS_PASSWORD=your_mongodb_express_password

# ========================================
# CACHE - Redis
# ========================================
REDIS_CONNECTION=localhost:6379
REDIS_PASSWORD=your_redis_password

# ========================================
# AUTHENTICATION - JWT
# ========================================
JWT_SECRET=SuperSecretKeyForLibraryHubManagementSystem2026!
JWT_ISSUER=LibraryHub
JWT_AUDIENCE=LibraryHubUsers
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Google authentication
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# SMTP email delivery
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=LibraryHub
EMAIL_USERNAME=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
WEB_BASE_URL=http://localhost:3000

# Media and payments
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SEPAY_BANK_ACCOUNT=your-bank-account
SEPAY_BANK_NAME=your-bank-name
SEPAY_ACCOUNT_NAME=your-account-name
SEPAY_API_KEY=your-sepay-api-key

# ========================================
# SERVER & CORS
# ========================================
PORT=5000
ASPNETCORE_ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
