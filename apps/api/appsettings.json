{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "libraryhub"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "LibraryHub_",
    "DefaultCacheTime": 60
  },
  "CORS_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:4200",
  "Jwt": {
    "Secret": "development-only-change-with-JWT_SECRET-env",
    "Issuer": "LibraryHub",
    "Audience": "LibraryHubUsers",
    "AccessExpiryMinutes": 15,
    "RefreshExpiryDays": 7
  },
  "FileStorage": {
    "MaxFileSize": 52428800,
    "AllowedImageExtensions": ".jpg,.jpeg,.png,.gif,.webp",
    "AllowedDocumentExtensions": ".pdf,.epub",
    "UploadPath": "uploads"
  },
  "Borrowing": {
    "DefaultBorrowDays": 14,
    "MaxBorrowLimit": 5,
    "MaxRenewCount": 2,
    "FinePerDay": 5000,
    "Currency": "VND"
  },
  "SePay": {
    "BankAccount": "105886719416",
    "BankName": "VietinBank",
    "AccountName": "HO QUOC NAM",
    "ApiKey": "YOUR_SEPAY_API_KEY"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET",
    "UploadPreset": "ml_default"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "Thư viện LibraryHub",
    "FromAddress": "libraryhub.dev@gmail.com",
    "Username": "YOUR_EMAIL_USERNAME",
    "Password": "YOUR_EMAIL_PASSWORD",
    "WebBaseUrl": "http://localhost:3000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
